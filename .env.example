# ============================================================
# STUDIA SAAS - CONFIGURAÇÃO DE VARIÁVEIS DE AMBIENTE
# ============================================================
# Copie este arquivo para .env.local. Nunca faça commit de .env.local.

# 1. CLIENT-SIDE (Expostas no navegador via Vite)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
VITE_APP_URL=http://localhost:3000

# 2. SERVER-SIDE (Privadas / Apenas Node.js - NUNCA expor no frontend)
PORT=3000
NODE_ENV=production
ALLOWED_ORIGINS=https://studia.com.br,https://app.studia.com.br,http://localhost:3000

# Chave mestra do Supabase para Webhooks e Automações no Backend
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Gateway de Pagamento: Stripe (Opcional)
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Gateway de Pagamento: Asaas / Pix (Opcional)
ASAAS_API_KEY=$aact_...
ASAAS_WEBHOOK_TOKEN=token_seguro_webhook

